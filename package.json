{
  "name": "dsh-strata",
  "version": "0.6.2",
  "description": "Strata model downloads, recursive shard inventory, manual setup and native auto-tuning for DSH.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/dsh-strata.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "python/*.py",
    "engine.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "catalog.json",
    "docs/*.md",
    "vendor/**",
    "runtime/**"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js && python3 -m unittest discover -s test -p '*_test.py'",
    "check": "eslint . && prettier --check index.js lib client test/*.js build.mjs",
    "format": "prettier --write index.js lib client test/*.js build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "eslint": "10.13.0",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@earendil-works/pi-ai": "1.3.0",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
